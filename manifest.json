{
  "manifest_version": 1,
  "id": "com.cctoolbox.jsongrid",
  "name": "CC 工具箱 · JSON 解析",
  "version": "0.1.10",
  "publisher": "cctoolbox",
  "description": "在 DBX 工作台里直接解析 JSON：树形/表格视图、嵌套展开、格式化、高级筛选、导出。",
  "icon": "assets/plugin.svg",
  "source": "https://github.com/chenmo02/xx",
  "engines": {
    "dbx": ">=0.6.0",
    "host_api": "1"
  },
  "permissions": [
    "host.storage"
  ],
  "entrypoints": {
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "com.cctoolbox.jsongrid.workbench",
      "label": "CC 工具箱 · JSON 解析",
      "description": "JSON 文本与表格双向查看：嵌套节点展开、条数统计、格式化、压缩、校验、高级筛选、CSV 导出。",
      "icon": "assets/plugin.svg",
      "ai": {
        "recommendations": [
          {
            "id": "inspect-json",
            "label": "分析当前 JSON 结构",
            "prompt": "分析当前工作台中 JSON 数据的结构、嵌套层级与潜在问题，并给出优化建议。",
            "order": 10
          }
        ]
      }
    },
    {
      "type": "command",
      "id": "com.cctoolbox.jsongrid.open",
      "label": "打开 CC 工具箱 · JSON 解析",
      "icon": "assets/plugin.svg",
      "action": {
        "type": "open-workbench",
        "workbench": "com.cctoolbox.jsongrid.workbench"
      }
    },
    {
      "type": "menus",
      "id": "com.cctoolbox.jsongrid.menus",
      "items": [
        {
          "location": "appToolbar",
          "command": "com.cctoolbox.jsongrid.open",
          "group": "primary",
          "order": 120,
          "default_visible": true
        },
        {
          "location": "commandPalette",
          "command": "com.cctoolbox.jsongrid.open",
          "group": "primary",
          "order": 120
        }
      ]
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "CC 工具箱 · JSON 解析",
      "description": "在 DBX 工作台里直接解析 JSON：树形/表格视图、嵌套展开、格式化、高级筛选、导出。",
      "contributions": {
        "com.cctoolbox.jsongrid.workbench": {
          "label": "CC 工具箱 · JSON 解析",
          "description": "JSON 文本与表格双向查看：嵌套节点展开、条数统计、格式化、压缩、校验、高级筛选、CSV 导出。"
        },
        "com.cctoolbox.jsongrid.open": {
          "label": "打开 CC 工具箱 · JSON 解析"
        }
      }
    }
  }
}
